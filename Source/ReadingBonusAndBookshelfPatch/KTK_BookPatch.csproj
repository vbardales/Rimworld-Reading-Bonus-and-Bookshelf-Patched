<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <!-- Nom d'assemblage et espace de noms conserves : les patchs XML visent
         KTK_BookMod.*, et les reglages sont enregistres sous le nom de la classe
         Mod. Les renommer casserait la continuite avec la version de Kutake. -->
    <AssemblyName>KTK_BookPatch</AssemblyName>
    <RootNamespace>KTK_BookMod</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Configuration>Release</Configuration>
    <OutputPath>..\..\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>CS0169;CS0649;CS0414;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*-*" />
  </ItemGroup>

</Project>
